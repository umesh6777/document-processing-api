# Copy to .env and adjust. Placeholder values only — never commit a real .env.
APP_NAME=Document Management API

# SQLite (default)
DATABASE_URL=sqlite:///./app.db
# PostgreSQL example (also: pip install psycopg[binary])
# DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<database>

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Simulated processing
PROCESSING_DELAY_SECONDS=2
PROCESSING_FAILURE_RATE=0.0
